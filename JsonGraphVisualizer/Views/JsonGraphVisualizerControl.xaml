<!-- Views/JsonGraphVisualizerControl.xaml -->
<UserControl x:Class="JsonGraphVisualizer.Views.JsonGraphVisualizerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:JsonGraphVisualizer.Converters"
             x:Name="RootControl"
             Background="{Binding ComponentBackground, ElementName=RootControl}">

    <UserControl.Resources>
        <converters:BezierPathConverter x:Key="BezierPathConverter"/>
        <converters:ArrowPathConverter x:Key="ArrowPathConverter"/>
        <converters:TruncateTextConverter x:Key="TruncateTextConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- استایل برای Button های expand/collapse -->
        <Style x:Key="ExpandButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border BorderBrush="#3E3E42" BorderThickness="1">
            <ScrollViewer x:Name="MainScrollViewer"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         PreviewMouseWheel="MainScrollViewer_PreviewMouseWheel"
                         PreviewMouseLeftButtonDown="MainScrollViewer_PreviewMouseLeftButtonDown"
                         PreviewMouseLeftButtonUp="MainScrollViewer_PreviewMouseLeftButtonUp"
                         PreviewMouseMove="MainScrollViewer_PreviewMouseMove">

                <Canvas x:Name="MainCanvas"
                        Background="Transparent"
                        Width="5000"
                        Height="5000"
                        RenderTransformOrigin="0.5,0.5">

                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="TranslateTransform" X="0" Y="0"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>

                    <!-- لایه Edge ها (پشت Node ها) -->
                    <ItemsControl ItemsSource="{Binding Edges}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Canvas Visibility="{Binding Visibility}">
                                    <!-- خط منحنی -->
                                    <Path Stroke="{Binding EdgeBrush, ElementName=RootControl}"
                                          StrokeThickness="2">
                                        <Path.Data>
                                            <MultiBinding Converter="{StaticResource BezierPathConverter}">
                                                <Binding Path="StartPoint"/>
                                                <Binding Path="EndPoint"/>
                                            </MultiBinding>
                                        </Path.Data>
                                    </Path>

                                    <!-- فلش -->
                                    <Path Fill="{Binding EdgeBrush, ElementName=RootControl}"
                                          Data="{Binding EndPoint, Converter={StaticResource ArrowPathConverter}}"/>
                                </Canvas>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- لایه Node ها -->
                    <ItemsControl ItemsSource="{Binding Nodes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding NodeBackground, ElementName=RootControl}"
                                        BorderBrush="{Binding NodeBorderBrush, ElementName=RootControl}"
                                        BorderThickness="2"
                                        CornerRadius="5"
                                        Width="{Binding Width}"
                                        MinHeight="{Binding Height}"
                                        Visibility="{Binding Visibility}"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="Node_MouseLeftButtonDown">

                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" 
                                                         Direction="315" 
                                                         ShadowDepth="3" 
                                                         BlurRadius="8" 
                                                         Opacity="0.5"/>
                                    </Border.Effect>

                                    <StackPanel Margin="10">
                                        <!-- Header -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Expand/Collapse Button -->
                                            <Button Grid.Column="0"
                                                   Content="{Binding ExpandCollapseIcon}"
                                                   Style="{StaticResource ExpandButtonStyle}"
                                                   Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisConverter}}"
                                                   Click="ExpandCollapseButton_Click"
                                                   Margin="0,0,5,0"/>

                                            <!-- Title -->
                                            <TextBlock Grid.Column="1"
                                                      Text="{Binding Title}"
                                                      FontFamily="{Binding GlobalFontFamily, ElementName=RootControl}"
                                                      FontSize="14"
                                                      FontWeight="Bold"
                                                      TextWrapping="Wrap"
                                                      VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="Object">
                                                                <Setter Property="Foreground" Value="{Binding ObjectTitleBrush, ElementName=RootControl}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="Array">
                                                                <Setter Property="Foreground" Value="{Binding ArrayTitleBrush, ElementName=RootControl}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="PropertyGroup">
                                                                <Setter Property="Foreground" Value="{Binding ObjectTitleBrush, ElementName=RootControl}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>

                                        <!-- Separator -->
                                        <Border Height="1"
                                               Background="#3E3E42"
                                               Margin="0,0,0,8"/>

                                        <!-- Properties -->
                                        <ItemsControl ItemsSource="{Binding Properties}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0"
                                                                  Text="{Binding Key, StringFormat='{}{0}:'}"
                                                                  Foreground="{Binding KeyTextBrush, ElementName=RootControl}"
                                                                  FontFamily="{Binding GlobalFontFamily, ElementName=RootControl}"
                                                                  FontSize="11"
                                                                  Margin="0,0,5,0"/>

                                                        <TextBlock Grid.Column="1"
                                                                  Foreground="{Binding ValueTextBrush, ElementName=RootControl}"
                                                                  FontFamily="{Binding GlobalFontFamily, ElementName=RootControl}"
                                                                  FontSize="11"
                                                                  TextWrapping="Wrap">
                                                            <TextBlock.Text>
                                                                <Binding Path="Value" Converter="{StaticResource TruncateTextConverter}"/>
                                                            </TextBlock.Text>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <!-- اگر متن truncate شده، دکمه ... نمایش بده -->
                                                                        <DataTrigger Binding="{Binding Value, Converter={StaticResource TruncateTextConverter}}" Value="{x:Null}">
                                                                            <Setter Property="Cursor" Value="Arrow"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                            
                                                            <!-- Hyperlink برای متن های truncate شده -->
                                                            <TextBlock.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick" 
                                                                            Command="{Binding ShowFullTextCommand}"/>
                                                            </TextBlock.InputBindings>
                                                        </TextBlock>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
