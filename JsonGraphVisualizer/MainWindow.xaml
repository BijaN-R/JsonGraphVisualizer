<Window x:Class="JsonGraphVisualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:JsonGraphVisualizer.Views"
        Title="JSON Graph Visualizer - Test" 
        Height="600" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 🧪 بخش تست -->
        <StackPanel Grid.Row="0" Margin="10" Orientation="Horizontal">
            <TextBox x:Name="JsonInput" 
                     Width="400" Height="100"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"/>
            <Button Content="Load JSON" 
                    Click="LoadJson_Click"
                    Margin="10,0,0,0"
                    Padding="15,5"/>
        </StackPanel>

        <!-- 📊 کنترل اصلی -->
        <views:JsonGraphVisualizerControl 
            x:Name="RootControl"
            Grid.Row="1"
            Background="#F5F5F5"/>
    </Grid>
</Window>
